#include <iostream>
using namespace std;

int main() {
    int choice;
    float value;

    cout << "1. Length (m to cm)\n";
    cout << "2. Weight (kg to g)\n";
    cout << "3. Temperature (C to F)\n";
    cout << "Enter choice: ";
    cin >> choice;

    cout << "Enter value: ";
    cin >> value;

    switch(choice) {
        case 1:
            cout << "Result: " << value * 100 << " cm";
            break;

        case 2:
            cout << "Result: " << value * 1000 << " g";
            break;

        case 3:
            cout << "Result: " << (value * 9/5) + 32 << " F";
            break;

        default:
            cout << "Invalid choice";
    }

    return 0;
}
